# Set these in the Vercel project's environment variables. Never put a real key here.

# Gemini (server-side only, used by api/explain.js). Required for written explanations.
GEMINI_API_KEY=
# Optional override of the pinned model (default gemini-3.5-flash-lite; see docs/DESIGN.md).
GEMINI_MODEL_FAST=

# Google Maps JavaScript API. Browser-visible by design: restrict it to the site's domain and the Maps JavaScript API in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID for a styled map (defaults to DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID=
