# Server-side only (Vercel env vars). Never put a real key here.
GEMINI_API_KEY=
# Browser-visible by design: restrict it to the site's domain and the Maps JavaScript API in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID for a styled map (defaults to DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID=
# Gemini (server-side only, used by api/explain.js). Pin a current stable model ID and record it in docs/DESIGN.md.
GEMINI_MODEL_FAST=
